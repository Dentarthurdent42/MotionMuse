{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && [ -d node_modules/playwright ] && node scripts/screenshot-sync.mjs --hook 2>/dev/null || true",
            "timeout": 180,
            "statusMessage": "Checking the README screenshot against the UI"
          }
        ]
      }
    ]
  }
}
